# Defines the dedicated inventory virtual host for an existing 1Panel OpenResty.
server {
    listen 80;
    listen [::]:80;
    server_name stock.789123465.xyz;

    location ^~ /.well-known/acme-challenge/ {
        root /www/sites/stock.789123465.xyz/acme;
        try_files $uri =404;
    }

    location / {
        return 301 https://$server_name$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name stock.789123465.xyz;
    ssl_certificate @CERTIFICATE@;
    ssl_certificate_key @CERTIFICATE_KEY@;

    root /www/sites/stock.789123465.xyz/index;
    index index.html;
    auth_basic "Stock workbench";
    auth_basic_user_file /www/sites/stock.789123465.xyz/access.htpasswd;
    add_header X-Robots-Tag "noindex, nofollow" always;

    location /api/ {
        client_max_body_size 64k;
        proxy_pass http://127.0.0.1:18083;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Authorization "";
    }

    location /assets/ {
        try_files $uri =404;
        expires 1y;
    }

    location / {
        try_files $uri $uri/ /index.html;
        expires -1;
    }
}
